body {
  margin: 0;
  background: #0b0f1a;
  color: white;
  font-family: sans-serif;
}

.container {
  max-width: 400px;
  margin: auto;
  padding: 20px;
}

.card {
  background: #111827;
  padding: 20px;
  border-radius: 15px;
  margin-bottom: 20px;
}

button {
  width: 100%;
  padding: 12px;
  background: #00c853;
  border: none;
  color: white;
  border-radius: 10px;
}

input {
  width: 100%;
  padding: 10px;
  margin-top: 10px;
  border-radius: 10px;
}
